# Copy to .env.local for local development. Never commit real values.

# Web3Forms access key (booking email + /posvet form). Required. Baked in at build time.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Online payment via Stripe. "true" shows the card button and Payment Links. Default off.
NEXT_PUBLIC_ENABLE_ONLINE_PAYMENT=false

# Only needed when online payment is enabled.
NEXT_PUBLIC_SITE_URL=https://www.akilea.si
STRIPE_SECRET_KEY=
