# Copy to .env.local for local development. Never commit real values.

# Web3Forms access key (booking email + /posvet form). Required. Baked in at build time.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Online payment via Stripe. "true" shows the card button and Payment Links. Default off.
NEXT_PUBLIC_ENABLE_ONLINE_PAYMENT=false

# Only needed when online payment is enabled.
NEXT_PUBLIC_SITE_URL=https://www.akilea.si
STRIPE_SECRET_KEY=

# Google Calendar booking (Phase B). Leave empty to use email-only booking.
# Service account from the Google Cloud project; store only the email and the private key,
# not the whole JSON file (Netlify function env size limit is about 4 KB).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key with literal \n line breaks, in double quotes.
GOOGLE_PRIVATE_KEY=
# Calendar ID of "Akilea rezervacije" (new bookings are written here).
GOOGLE_BOOKING_CALENDAR_ID=
# Comma separated calendars whose events block slots: her primary calendar and the booking calendar.
GOOGLE_BUSY_CALENDAR_IDS=
